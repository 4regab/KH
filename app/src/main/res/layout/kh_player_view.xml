<?xml version="1.0" encoding="utf-8"?>
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kh_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:focusable="true"
    app:animation_enabled="true"
    app:controller_layout_id="@layout/kh_player_controls"
    app:play_icon="@drawable/ic_player_play"
    app:pause_icon="@drawable/ic_player_pause"
    app:hide_on_touch="false"
    app:show_buffering="always"
    app:show_subtitle_button="false"
    app:show_timeout="4000"
    app:shutter_background_color="@android:color/black"
    app:use_controller="true" />
